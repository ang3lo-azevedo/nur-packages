+# ─── BitLocker FVEK Scan (Windows only) ─────────────────────────────────────
+
+bitlocker_scan() {
+    header "Scanning for BitLocker keys"
+
+    local bl_dir="${OUTPUT_DIR}/bitlocker"
+    mkdir -p "$bl_dir"
+
+    info "Running windows.bitlocker.BitlockerFVEKScan..."
+    if ! "$VOL" -o "$bl_dir/" -f "$MEMORY_DUMP" windows.bitlocker.BitlockerFVEKScan --dislocker \
+            > "${OUTPUT_DIR}/bitlocker.txt" 2>"${OUTPUT_DIR}/bitlocker.err"; then
+        BITLOCKER_HITS="error"
+        warn "BitLocker scan failed (check bitlocker.err)"
+        return
+    fi
+
+    BITLOCKER_HITS=$(find "$bl_dir" -name '*.fvek' -type f 2>/dev/null | wc -l)
+    if (( BITLOCKER_HITS == 0 )); then
+        rmdir "$bl_dir" 2>/dev/null || true
+        info "No BitLocker keys found (no volume was unlocked when the dump was taken)"
+        return
+    fi
+
+    success "Found ${BITLOCKER_HITS} candidate FVEK(s), keys in bitlocker.txt"
+    info "Unlock with: dislocker -k ${bl_dir}/<hit>-Dislocker.fvek -V <disk image> <mountpoint>"
+}
+
