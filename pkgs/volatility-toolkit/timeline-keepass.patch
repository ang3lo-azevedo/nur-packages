+# ─── KeePass Scan (Windows only) ────────────────────────────────────────────
+
+# windows.keepass needs the KeePass PID, so it only runs when pslist found one.
+# KeePassXC is a different program and not affected (CVE-2023-32784).
+keepass_scan() {
+    local pids pid
+    pids=$(awk -F'\t' 'tolower($3) == "keepass.exe" { print $1 }' "${OUTPUT_DIR}/pslist.txt" 2>/dev/null)
+    [[ -n "$pids" ]] || return 0
+
+    header "Scanning KeePass memory"
+    for pid in $pids; do
+        info "Running windows.keepass.KeePass on PID ${pid}..."
+        if "$VOL" -f "$MEMORY_DUMP" windows.keepass.KeePass --pid "$pid" \
+                > "${OUTPUT_DIR}/keepass_${pid}.txt" 2>"${OUTPUT_DIR}/keepass_${pid}.err"; then
+            success "Master password candidates in keepass_${pid}.txt"
+        else
+            warn "KeePass scan of PID ${pid} failed (check keepass_${pid}.err)"
+        fi
+    done
+}
+
+# ─── Super-Timeline ──────────────────────────────────────────────────────────
+
+timeline_scan() {
+    header "Building super-timeline"
+
+    local tl_dir="${OUTPUT_DIR}/timeline"
+    mkdir -p "$tl_dir"
+
+    info "Running timeliner.Timeliner (slow, it reruns every plugin with timestamps)..."
+    if "$VOL" -o "$tl_dir/" -f "$MEMORY_DUMP" timeliner.Timeliner --create-bodyfile \
+            > "${OUTPUT_DIR}/timeliner.txt" 2>"${OUTPUT_DIR}/timeliner.err"; then
+        success "Timeline in timeliner.txt, bodyfile in timeline/volatility.body"
+        info "For a CSV timeline: mactime -b ${tl_dir}/volatility.body -d > timeline.csv"
+    else
+        warn "Timeline failed (check timeliner.err)"
+    fi
+}
+
