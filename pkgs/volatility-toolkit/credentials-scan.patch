+# ─── LSASS Credential Scan (Windows only) ────────────────────────────────────
+
+credentials_scan() {
+    header "Extracting credentials from LSASS"
+
+    info "Running windows.pypykatz..."
+    if ! "$VOL" -f "$MEMORY_DUMP" windows.pypykatz \
+            > "${OUTPUT_DIR}/pypykatz.txt" 2>"${OUTPUT_DIR}/pypykatz.err"; then
+        # pypykatz raises this when the lsasrv.dll pages holding the LSA keys were paged out
+        if grep -q "All detection methods failed" "${OUTPUT_DIR}/pypykatz.err"; then
+            CREDENTIAL_HITS="none (LSA keys not resident in dump)"
+            warn "LSASS key material was not resident in the dump, no credentials recovered"
+        else
+            CREDENTIAL_HITS="error (see pypykatz.err)"
+            warn "Credential scan failed (check pypykatz.err)"
+        fi
+        return
+    fi
+
+    local hits
+    hits=$(awk -F'\t' '$1 == "credtype" { h = 1; next } h && NF' "${OUTPUT_DIR}/pypykatz.txt" | wc -l)
+    CREDENTIAL_HITS="${hits} (see pypykatz.txt)"
+    if (( hits == 0 )); then
+        info "No credentials found in LSASS"
+        return
+    fi
+
+    success "Found ${hits} credential(s), see pypykatz.txt"
+}
+
